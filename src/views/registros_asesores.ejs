<% layout('layout/layoutPrincipal') %>

<div>
    <h3>Registrar asesor</h3>
        <div>
            <form action="/asesores" method="POST">
                <div class="mb-3">
                    <label for="nombre" class="form-label">Nombre del Asesor</label>
                    <input type="text" class="form-control" id="nombre" name="nombre" required>
                </div>
                <div class="mb-3">
                    <label for="correo" class="form-label">Correo Electrónico</label>
                    <input type="email" class="form-control" id="correo" name="correo" required>
                </div>
                <div class="mb-3">
                    <label for="telefono" class="form-label">Teléfono</label>
                    <input type="tel" class="form-control" id="telefono" name="telefono">
                </div>
                <button type="submit" class="btn btn-primary">Registrar Asesor</button>
            </form>
        </div>
</div>
