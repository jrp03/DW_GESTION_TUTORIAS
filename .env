# config app variables
APP_HOST=localhost
PORT=3001
JWT_SECRET = clave_secreta
JWT_EXPIRATION = 3600

# Configuración común
DB_TYPE=mysql 
DB_HOST=localhost
DB_PORT=3306 
DB_USER=root
DB_PASSWORD= 
DB_NAME= 
DB_INSTANCE=MSSQLSERVER # Solo para SQL Server

# Configuración del pool
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE=30000
DB_CONNECTION_TIMEOUT=60000

# Configuración específica de SQL Server
DB_ENCRYPT=false
DB_TRUST_CERTIFICATE=true
