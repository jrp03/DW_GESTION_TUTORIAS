<%- include('partials/head'); %>
    <link rel="stylesheet" href="css/login.css">
    <title>Login - USER</title>
</head>
<body>
    <div class="panel">
        <div class="form-panel">
            <div class="panel-header">          
                <h1>Sistema de Tutorías</h1>
                <h3>Gestion de tutores</h3>
            </div>
            <form action="/" method="post">
                <h3>Login</h3>
                <div class="input-container">
                    <p>Correo:</p>
                    <input type="email" name="id" placeholder="ID del usuario" required>
                </div>
                <div class="input-container">
                    <p>Contraseña:</p>  
                    <input type="password" placeholder="Contraseña" name="password" required>
                </div>
                <input type="submit" value="Iniciar sesión" class="btn-loggin">
                <p>¿Olvidaste tu contraseña? <a href="">Recuperala aquí</a> </p>
            </form>
        </div>
    </div>
</body>
</html>